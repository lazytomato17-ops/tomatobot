DISCORD_TOKEN=your_discord_bot_token
PORT=10000

# 複数の占い師・狂人を設定できるβテスターのDiscordユーザーID（カンマ区切り）
BETA_TESTER_IDS=1010400040797360218,1439620582504402964

# SupabaseのProject URL
SUPABASE_URL=https://your-project.supabase.co

# Renderだけに保存してください。GitHubやDiscordには貼らないでください。
# 新しいSupabaseプロジェクトではSecret key、従来形式ではservice_role keyを使います。
SUPABASE_SECRET_KEY=your_supabase_secret_key
