{
    "name": "tomatobot",
    "version": "1.0.0",
    "description": "Discord上で動作する、NPC（AI）参加対応の人狼ゲーム Bot",
    "main": "dist/index.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/lazytomato17-ops/tomatobot.git"
    },
    "author": "lazytomato17-ops",
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node src/index.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "ci": "npm run typecheck && npm run lint && npm run test",
        "prepare": "husky || true"
    },
    "keywords": [
        "discord-bot",
        "werewolf",
        "jinro",
        "discord.js",
        "typescript"
    ],
    "type": "commonjs",
    "dependencies": {
        "@discordjs/voice": "^0.17.0",
        "@google/genai": "latest",
        "@supabase/supabase-js": "^2.39.0",
        "discord.js": "^14.25.1",
        "dotenv": "^16.4.5",
        "groq-sdk": "latest",
        "libsodium-wrappers": "^0.7.14",
        "node-cron": "^3.0.3",
        "opusscript": "^0.0.8",
        "pg": "^8.11.3",
        "prism-media": "^1.3.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/dotenv": "^8.2.3",
        "@types/node": "^25.5.0",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.11.0",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "prettier": "^3.8.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.61.1",
        "vitest": "^4.1.9"
    }
}
